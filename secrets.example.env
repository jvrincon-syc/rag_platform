# Copy this file to secrets.env and adjust local values.


# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=rag_platform
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
DATABASE_URL=postgresql://postgres@localhost:5432/rag_platform
# Durable platform DSN. When set, the GUI server composes on PostgreSQL.
RAG_PLATFORM_POSTGRES_DSN=postgresql://postgres@localhost:5432/rag_platform
# Legacy compatibility only; prefer RAG_PLATFORM_POSTGRES_DSN.
SST_POSTGRES_DSN=

# Pipeline composition
# Persistence mode: memory | postgres. Unset -> postgres when RAG_PLATFORM_POSTGRES_DSN
# is set, otherwise memory. Production must not silently fall back to memory.
SST_PERSISTENCE_MODE=
# HTTP bearer auth for the internal FastAPI surface. JSON array of
# {"principal_id","token","project_scope"} objects. Empty = fail closed (503).
SST_HTTP_AUTH_CREDENTIALS_JSON=
# Server-controlled consumer scope for activation/rollback (never from the body).
SST_CONSUMER_SCOPE_TYPE=chatbot
SST_CONSUMER_SCOPE_ID=sst-default

# Rollout feature flags (off by default keeps the legacy path available)
SST_FEATURE_EMBEDDING_V2=false
SST_FEATURE_INDEXING_BUNDLE_FIRST=false
SST_FEATURE_RETRIEVAL_V1=true
SST_FEATURE_CHATBOT_WEBHOOK_V1=true
SST_FEATURE_RAG_PLATFORM_V1=true

# Chatbot question dispatch -> downstream answer webhook
# Replace the URL below with the real webhook endpoint that will receive the
# question plus retrieved chunks for final LLM answering.
SST_CHATBOT_WEBHOOK_URL=http://localhost:8787/api/webhooks/chatbot-answer
SST_CHATBOT_WEBHOOK_BEARER_TOKEN=
SST_CHATBOT_WEBHOOK_TIMEOUT_SECONDS=10

# Remote BGE-M3 studio (retrieval/infrastructure/remote_bge.py). Required only
# when the remote embedding/rerank runtime is selected.
REMOTE_BGE_URL=
REMOTE_BGE_KEY=
# Candidate pool size before reranking (retrieval/application/retrieval_service.py).
RETRIEVAL_RERANK_POOL_SIZE=

# FAQ shortcut (retrieval/infrastructure/faq_resolver.py, api/dependencies.py).
# FAQ_MATCH=off disables the shortcut outright (fail-closed opt-out).
FAQ_MATCH=on
# Explicit override path to one project's FAQ file; leave empty for the default lookup.
FAQ_PATH=
# Minimum fuzzy-match score (0-1) for a FAQ hit to short-circuit retrieval.
FAQ_THRESHOLD=0.85

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379/0

# OCR / ingestion
OCR_TEMP_DIR=.tmp/ocr
OCR_KEEP_TEMP=false
OCR_LOW_CONFIDENCE_THRESHOLD=0.70
OCR_TIMEOUT_SECONDS=180
TESSERACT_CMD=tesseract
TESSERACT_LANGUAGE=spa
TESSERACT_VERSION=5.4.0.20240606
OCR_ENABLE_OCRMYPDF=false
OCRMYPDF_CMD=ocrmypdf
GHOSTSCRIPT_CMD=

# Future providers. Keep empty until configured locally.
OPENAI_API_KEY=
VOYAGE_API_KEY=

# Embeddings runtime
EMBEDDING_PROVIDER=mock
EMBEDDING_MODEL=
EMBEDDING_DIMENSION=
EMBEDDING_DISTANCE_METRIC=cosine
EMBEDDING_BATCH_SIZE=32
EMBEDDING_DEVICE=cpu
EMBEDDING_TIMEOUT_SECONDS=30
EMBEDDING_RETRIES=2
BGE_USE_FP16=false
BGE_QUERY_MAX_LENGTH=512
BGE_DOCUMENT_MAX_LENGTH=8192
HF_TOKEN=
HF_HUB_CACHE=

# Llama Cloud / LlamaParse experimental ingestion
LLAMA_CLOUD_ENABLED=false
LLAMA_CLOUD_API_KEY=
LLAMA_PARSE_TIER=cost_effective
LLAMA_PARSE_VERSION=latest
LLAMA_PARSE_OCR_LANGUAGES=es
LLAMA_PARSE_EXPAND=markdown,items,metadata,job_metadata
LLAMA_PARSE_MAX_CONCURRENCY=2
LLAMA_PARSE_TIMEOUT_SECONDS=900
LLAMA_PARSE_MAX_CREDITS_PER_RUN=500
LLAMA_PARSE_STORE_RAW_RESULTS=true
LLAMA_PARSE_GRANULAR_BBOXES=false
LLAMA_CLASSIFY_MODE=FAST
LLAMA_CLASSIFY_MAX_PAGES=5
LLAMA_EXTRACT_TIER=cost_effective
LLAMA_EXTRACT_PARSE_TIER=fast
LLAMA_EXTRACT_MAX_PAGES=5
LLAMA_CLASSIFY_ENABLED=true
LLAMA_EXTRACT_ENABLED=true
LLAMA_LOCAL_FALLBACK_ENABLED=true

